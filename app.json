{
  "expo": {
    "name": "Quizly",
    "slug": "quizly",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "quizly",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "kr.co.quizly.app"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
